        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "patient_name",
          "diagnosis_label",
          "koc",
          "referring_doctor_id",
          "coordinator_id",
          "state",
          "queue",
          "on_move",
          "next_step",
          "next_due",
          "mdt_date",
          "created_at",
          "on_hold",
          "milestones"
        ],
        "title": "CaseDto"
      },
      "CaseState": {
        "type": "string",
        "enum": [
          "odeslano",
          "v_triage",
