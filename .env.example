# Copy to .env (never commit .env). Every dev supplies their own values.

# --- IRIS (shared instance in Azure) ---
# iris://USER:PASSWORD@HOST:PORT/NAMESPACE   (URL-encode special characters in user/password)
# Setting it switches the API from the in-memory fake to IRIS (Q-I13).
ONKO_IRIS_CONNECTION_STRING=
# Optional: name of an SSL/TLS configuration for iris.connect(sslconfig=...) (Q-I4)
ONKO_IRIS_SSL_CONFIG=
# SQL schema of the app-state tables (default onko)
ONKO_IRIS_SCHEMA=
# FHIR R4 REST endpoint on the same instance (basic auth), e.g. http://HOST:52773/fhir/r4
# (created by scripts/fhir_server.py). Set → every save is also projected to FHIR.
ONKO_FHIR_BASE_URL=
ONKO_FHIR_USERNAME=
ONKO_FHIR_PASSWORD=

# --- Models: our OpenAI-compatible endpoints (Azure deployments) ---
# Bench candidates (Q-M5); the bench runs all of them and we pick ONE as active (Q-M1).
# The active model and the embedding model must be EU Data Zone (Q-M6).
# NAME is the Azure deployment name, which may differ from the model name
#   (EU Data Zone: sol = gpt-6-1-sol-dz-eu, luna = gpt-6-luna-dz-eu).
# All sit behind Azure API Management: base url https://apim-rakathon-q7146n.azure-api.net/openai/v1,
# the key goes in the `api-key` header. The bench of 16. 10. picked sol (Q-M1).
ONKO_MODELS=sol,luna,astra,deepseek,grok,mai,embed

# gpt-6.1-sol (EU Data Zone)
ONKO_MODEL_SOL_BASE_URL=
ONKO_MODEL_SOL_API_KEY=
ONKO_MODEL_SOL_NAME=

# gpt-6-luna (EU Data Zone)
ONKO_MODEL_LUNA_BASE_URL=
ONKO_MODEL_LUNA_API_KEY=
ONKO_MODEL_LUNA_NAME=

# gpt-6-astra (Global, bench only)
ONKO_MODEL_ASTRA_BASE_URL=
ONKO_MODEL_ASTRA_API_KEY=
ONKO_MODEL_ASTRA_NAME=

# DeepSeek-V4-Pro (Global, bench only)
ONKO_MODEL_DEEPSEEK_BASE_URL=
ONKO_MODEL_DEEPSEEK_API_KEY=
ONKO_MODEL_DEEPSEEK_NAME=

# grok-4.7 (Global, bench only)
ONKO_MODEL_GROK_BASE_URL=
ONKO_MODEL_GROK_API_KEY=
ONKO_MODEL_GROK_NAME=

# MAI-Thinking-1 (Global, bench only)
ONKO_MODEL_MAI_BASE_URL=
ONKO_MODEL_MAI_API_KEY=
ONKO_MODEL_MAI_NAME=

# Embedding model, EU Data Zone; not deployed yet (Q-M7). Its dimension sets VECTOR(DOUBLE, n).
ONKO_MODEL_EMBED_BASE_URL=
ONKO_MODEL_EMBED_API_KEY=
ONKO_MODEL_EMBED_NAME=

# Until the bench picks (Q-M1): an EU Data Zone slot, sol or luna (Q-M6)
ONKO_ACTIVE_MODEL=sol
ONKO_EMBED_MODEL=embed

# --- App ---
ONKO_SEED_REFERENCE=1
ONKO_CORS_ORIGINS=http://localhost:5173
