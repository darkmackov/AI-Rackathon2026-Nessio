# Copy to .env (never commit .env). Every dev supplies their own values.

# --- IRIS (shared instance in Azure) ---
# iris://USER:PASSWORD@HOST:PORT/NAMESPACE   (URL-encode special characters in user/password)
# Setting it switches the API from the in-memory fake to IRIS (Q-I13).
ONKO_IRIS_CONNECTION_STRING=
# Optional: name of an SSL/TLS configuration for iris.connect(sslconfig=...) (Q-I4)
ONKO_IRIS_SSL_CONFIG=
# SQL schema of the app-state tables (default onko)
ONKO_IRIS_SCHEMA=
# FHIR R4 REST endpoint on the same instance (basic auth), e.g. http://HOST:52773/fhir/r4
# (created by scripts/fhir_server.py). Set → every save is also projected to FHIR.
ONKO_FHIR_BASE_URL=
ONKO_FHIR_USERNAME=
ONKO_FHIR_PASSWORD=

# --- Models: our OpenAI-compatible endpoints ---
# Candidates (the bench runs all of them); we pick ONE as active (Q-M1).
ONKO_MODELS=a,b,embed

ONKO_MODEL_A_BASE_URL=
ONKO_MODEL_A_API_KEY=
ONKO_MODEL_A_NAME=

ONKO_MODEL_B_BASE_URL=
ONKO_MODEL_B_API_KEY=
ONKO_MODEL_B_NAME=

ONKO_MODEL_EMBED_BASE_URL=
ONKO_MODEL_EMBED_API_KEY=
ONKO_MODEL_EMBED_NAME=

ONKO_ACTIVE_MODEL=a
ONKO_EMBED_MODEL=embed

# --- App ---
ONKO_SEED_REFERENCE=1
ONKO_CORS_ORIGINS=http://localhost:5173
